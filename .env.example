# AI Development Core — Phase 1-A (default OFF). Do not enable on Production.
# Server gate. Leave unset/false so existing users never see or start AI runs.
AI_DEV_ENABLED=false
# Client panel visibility (build-time). Keep false unless Staging PoC.
NEXT_PUBLIC_AI_DEV_ENABLED=false
# Public origin for Cursor/GitHub App webhooks. Set explicitly on Staging.
# Do not fall back to a production homepage URL.
AI_DEV_PUBLIC_BASE_URL=
# Store on the CyberConnect host only, never on customer repositories.
CURSOR_API_KEY=
CURSOR_AGENT_WEBHOOK_SECRET=
AI_DEV_GITHUB_APP_ID=
AI_DEV_GITHUB_APP_PRIVATE_KEY=
AI_DEV_GITHUB_APP_WEBHOOK_SECRET=
