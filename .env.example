# DeepL — sheet bilingual auto-translate (server-only)
# API Free keys use https://api-free.deepl.com ; Pro uses https://api.deepl.com
DEEPL_AUTH_KEY=
DEEPL_API_URL=https://api-free.deepl.com
DEEPL_AUTO_TRANSLATE=true

# Supabase (existing app config — copy from your project)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# GitHub Issues — create/link/sync from CyberConnect Tasks (server-only)
# Fine-grained PAT: Issues Read and write on the target repo
GITHUB_ISSUES_TOKEN=
GITHUB_OWNER=rapture-org-dev
GITHUB_REPO=CyberConnect_development
# Webhook secret (GitHub repo → Settings → Webhooks)
GITHUB_WEBHOOK_SECRET=
# Required for webhook inbound sync (bypasses RLS). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Discord → GitHub Issue (/api/discord/interactions)
# For local: expose with ngrok and set Interactions Endpoint to https://xxxx/api/discord/interactions
DISCORD_PUBLIC_KEY=

# AI Development Core — Phase 1-A (default OFF). Do not enable on Production yet.
# Server gate. Leave unset/false so existing users never see or start AI runs.
AI_DEV_ENABLED=false
# Client panel visibility (build-time). Keep false unless Staging PoC.
NEXT_PUBLIC_AI_DEV_ENABLED=false
# Public origin for Cursor agent webhooks, e.g. https://cyberconnectstaging.vercel.app
AI_DEV_PUBLIC_BASE_URL=
# Same Cursor API key pattern as Actions; store on CyberConnect host only, never on customer repos.
CURSOR_API_KEY=
CURSOR_AGENT_WEBHOOK_SECRET=
AI_DEV_GITHUB_APP_ID=
AI_DEV_GITHUB_APP_PRIVATE_KEY=
AI_DEV_GITHUB_APP_WEBHOOK_SECRET=
# Optional allowlists (leave empty to allow any guild/channel)
# DISCORD_ALLOWED_GUILD_ID=
# DISCORD_ALLOWED_CHANNEL_ID=
